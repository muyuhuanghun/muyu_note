		{"id":"8261c4355a5b1d7d","type":"text","text":"1.prepare dataset","x":-200,"y":36,"width":250,"height":60},
		{"id":"a065e0dbe4414246","type":"text","text":"$$\n\\hat y = \\omega *x +b\n$$","x":100,"y":120,"width":250,"height":60},
		{"id":"11fa91bb3b06965f","type":"text","text":"$$\nx \\in R , \\hat y \\in R\n$$","x":390,"y":120,"width":250,"height":60},
		{"id":"89550870ea186462","type":"text","text":"$$\n\\hat y_1 = \\omega *x_1+b\n$$","x":100,"y":220,"width":250,"height":60,"color":"1"},
		{"id":"c636fc1235df33cd","type":"text","text":"$$\n\\hat y_2 = \\omega *x_2+b\n$$","x":100,"y":320,"width":250,"height":60,"color":"1"},
		{"id":"7de7bae5721658bd","type":"text","text":"$$\n\\hat y_3 = \\omega *x_3+b\n$$","x":100,"y":420,"width":250,"height":60,"color":"1"},
		{"id":"c4c272deb8d6da97","type":"text","text":"$$\n\\qquad\n\\begin{bmatrix}\n\\hat y_1  \\\\\n\\hat y_2  \\\\\n\\hat y_3 \n\\end{bmatrix}\n= \\omega *\n\\begin{bmatrix}\nx_1 \\\\\nx_2 \\\\\nx_3 \\\\\n\\end{bmatrix}\n+b\n$$","x":390,"y":220,"width":290,"height":130,"color":"1"},
		{"id":"be92a672dd32b133","type":"text","text":"$$\n(\\hat y - y)^2\n$$","x":100,"y":520,"width":250,"height":60,"color":"6"},
