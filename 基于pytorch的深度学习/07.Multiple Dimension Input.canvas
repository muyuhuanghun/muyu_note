		{"id":"eddf51eae6bfccf4","type":"text","text":"$$\n\\hat y ^{(i)} = \\sigma (x^ {(i)} * \\omega + b)\n$$","x":-160,"y":20,"width":250,"height":60},
		{"id":"e55f165e9ee3356a","type":"text","text":"$$\n\\hat y ^{(i)} = \\sigma (\\sum_{n=1}^{k} x_n ^{(i)} * \\omega_n +b )\n$$","x":180,"y":20,"width":250,"height":60},
		{"id":"65b8fae514245969","type":"text","text":"$$\n\\begin{bmatrix}\n\\omega_1,\\omega_2,... ,\\omega_n\n\\end{bmatrix}\n\\begin{bmatrix}\nx_1\\\\\nx_2\\\\\n.\\\\\n.\\\\\n.\\\\\nx_n\n\\end{bmatrix}\n\n$$","x":480,"y":-100,"width":340,"height":180},
		{"id":"e531a77fd7310bc0","type":"text","text":"$$\n\\omega ^T*X\n$$","x":880,"y":-100,"width":250,"height":60},
		{"id":"e770c03a11396fff","type":"text","text":"$$\nX^T *\\omega\n$$","x":880,"y":20,"width":250,"height":60},
		{"id":"319dc71c35e655c5","type":"text","text":"$$\n\\hat y ^{(i)} = \\sigma (\\begin{bmatrix}\nx_1^{(i)},x_2^{(i)},...,x_n{(i)}\n\\end{bmatrix}\n\\begin{bmatrix}\n\\omega_1\\\\\n\\omega_2\\\\\n.\\\\\n.\\\\\n.\\\\\n\\omega_n\n\\end{bmatrix}\n+b)\n$$","x":105,"y":140,"width":401,"height":202},
		{"id":"08105e7e14e87745","type":"text","text":"$$\n=\\sigma(z^{(i)})\n$$","x":525,"y":211,"width":250,"height":60},
		{"id":"ec31c78513a8f3e5","type":"text","text":"Mini-Batch(N samples)","x":-160,"y":480,"width":250,"height":60},
		{"id":"de239ee246e1338e","type":"text","text":"$$\n\\begin{bmatrix}\n\\hat{y}^{(1)} \\\\\n\\vdots \\\\\n\\hat{y}^{(N)}\n\\end{bmatrix}\n=\n\\begin{bmatrix}\n\\sigma(z^{(1)}) \\\\\n\\vdots \\\\\n\\sigma(z^{(N)})\n\\end{bmatrix}\n=\n\\sigma \\left(\n\\begin{bmatrix}\nz^{(1)} \\\\\n\\vdots \\\\\nz^{(N)}\n\\end{bmatrix}\n\\right)\n$$","x":149,"y":444,"width":314,"height":132},
		{"id":"4c6cc42fc57d0238","type":"text","text":"sigmoid function is in an element-wise fashion","x":525,"y":480,"width":250,"height":60},
		{"id":"0e17155a8eebdfb2","type":"text","text":"$$\n\\begin{aligned}\nz^{(1)} &= \n\\begin{bmatrix}\nx_1^{(1)} & \\cdots & x_8^{(1)}\n\\end{bmatrix}\n\\begin{bmatrix}\n\\omega_1 \\\\\n\\vdots \\\\\n\\omega_8\n\\end{bmatrix}\n+ b \\\\\n&\\vdots \\\\\nz^{(N)} &= \n\\begin{bmatrix}\nx_1^{(N)} & \\cdots & x_8^{(N)}\n\\end{bmatrix}\n\\begin{bmatrix}\n\\omega_1 \\\\\n\\vdots \\\\\n\\omega_8\n\\end{bmatrix}\n+ b\n\\end{aligned}\n$$","x":128,"y":620,"width":357,"height":240},
		{"id":"bddd196372a01c54","type":"text","text":"$$\n\\begin{bmatrix}\nz^{(1)} \\\\\n\\vdots \\\\\nz^{(N)}\n\\end{bmatrix}\n=\n\\begin{bmatrix}\nx_1^{(1)} & \\cdots & x_8^{(1)} \\\\\n\\vdots    & \\ddots & \\vdots    \\\\\nx_1^{(N)} & \\cdots & x_8^{(N)}\n\\end{bmatrix}\n\\begin{bmatrix}\n\\omega_1 \\\\\n\\vdots   \\\\\n\\omega_8\n\\end{bmatrix}\n+\n\\begin{bmatrix}\nb \\\\\n\\vdots \\\\\nb\n\\end{bmatrix}\n$$","x":525,"y":652,"width":384,"height":177},
		{"id":"fbb85e361b109d95","type":"text","text":"```\nclass Model(torch.nn.Module):\n\tdef__init__(self):\n\t\tsuper(Model,self).__init__()\n\t\tself.linear = torch.nn.Linear(8,1)\n\t\tself.sigmoid = torch.nn.Sigmoid()\n\t\t\n\tdef forward(self,x):\n\t\tx = self.sigmoid(self.linear(x))\n\t\treturn x\n\nmodel = Model()\n```","x":1005,"y":576,"width":559,"height":332},
		{"id":"8bb9a13174cedc6d","type":"text","text":"```\nself.linear = torch.nn.Linear(m,n)\n```","x":-219,"y":1000,"width":368,"height":60},
		{"id":"2799386391d2d3d6","type":"file","file":"基于pytorch的深度学习/pythorch photos/linear layer.png","x":250,"y":934,"width":400,"height":193},
		{"id":"e1ece031bd64556d","type":"text","text":"从高维降低到低维，通过添加 σ 的方式，逐步拟合一种非线性的空间变换函数，σ称为激活函数","x":295,"y":1200,"width":311,"height":90},
		{"id":"ee4c4a63933f24e8","type":"file","file":"基于pytorch的深度学习/pythorch photos/linear layer 2.png","x":709,"y":934,"width":424,"height":193},
		{"id":"36ff101dfd572f0d","type":"text","text":"超参数搜索","x":796,"y":1215,"width":250,"height":60},
		{"id":"8b0fb741cd0feedb","type":"file","file":"基于pytorch的深度学习/pythorch photos/artificial neural network.png","x":250,"y":1400,"width":400,"height":252},
		{"id":"9ed4aede2aa6a766","type":"file","file":"基于pytorch的深度学习/07.Multiple Dimension Input.md","x":-1600,"y":-310,"width":946,"height":1170},
		{"id":"a1d5730cec326635","type":"text","text":"```\n#  \n# import numpy as np  \n# import torch  \n# from sklearn.datasets import load_diabetes  \n#  \n# # 1. 加载并规范化数据  \n# diabetes = load_diabetes()  \n# x_numpy = diabetes.data  \n# y_numpy = diabetes.target  \n#  \n# x_data = torch.from_numpy(x_numpy).float()  \n# y_data = torch.from_numpy(y_numpy).float().reshape(-1, 1)  \n#  \n#  \n# # 2. 重新设计非线性网络  \n# class RegressionModel(torch.nn.Module):  \n#     def __init__(self):  \n#         super(RegressionModel, self).__init__()  \n#         self.linear1 = torch.nn.Linear(10, 6)  \n#         self.linear2 = torch.nn.Linear(6, 4)  \n#         self.linear3 = torch.nn.Linear(4, 1)  # 输出层  \n#  \n#         # 抛弃 Sigmoid，拥抱 ReLU 激活函数，彻底解决梯度消失  \n#         self.relu = torch.nn.ReLU()  \n#  \n#     def forward(self, x):  \n#         x = self.relu(self.linear1(x))  # 第一层激活  \n#         x = self.relu(self.linear2(x))  # 第二层激活  \n#         x = self.linear3(x)  # 最后一层：回归任务不加任何激活函数！  \n#         return x  \n#  \n#  \n# model = RegressionModel()  \n#  \n# # 3. 更换更符合任务的 MSE 损失函数和更聪明的 Adam 优化器  \n# criterion = torch.nn.MSELoss(reduction='mean')  # 用 mean（平均）可以让 Loss 数字看起来更合理  \n# optimizer = torch.optim.Adam(model.parameters(), lr=0.1)  # Adam 针对多层网络比 SGD 稳健得多  \n#  \n# # 4. 训练  \n# for epoch in range(100):  \n#     y_pred = model(x_data)  \n#     loss = criterion(y_pred, y_data)  \n#     print(f\"Epoch: {epoch}, Loss: {loss.item():.4f}\")  \n#  \n#     optimizer.zero_grad()  \n#     loss.backward()  \n#     optimizer.step()  \n#\n```","x":-1600,"y":1060,"width":946,"height":1100},
		{"id":"babbe5b2ff9a3dbe","type":"text","text":"```\nimport numpy as np  \nimport torch  \nfrom sklearn.datasets import load_diabetes  \nfrom sklearn.preprocessing import StandardScaler  # 引入标准化工具  \n  \n# 1. 加载数据  \ndiabetes = load_diabetes()  \nx_numpy = diabetes.data  \ny_numpy = diabetes.target.reshape(-1, 1)  # 提前转成二维  \n  \n# 🌟 核心魔法：将 y 压缩到均值为 0，方差为 1 的正态分布  \nscaler_y = StandardScaler()  \ny_scaled = scaler_y.fit_transform(y_numpy)  \n  \n# 转换为 Tensor\nx_data = torch.from_numpy(x_numpy).float()  \ny_data = torch.from_numpy(y_scaled).float()  # 使用标准化后的 y  \n  \n# 2. 定义非线性网络  \nclass RegressionModel(torch.nn.Module):  \n    def __init__(self):  \n        super(RegressionModel, self).__init__()  \n        self.linear1 = torch.nn.Linear(10, 6)  \n        self.linear2 = torch.nn.Linear(6, 4)  \n        self.linear3 = torch.nn.Linear(4, 1)  \n        self.relu = torch.nn.ReLU()  \n  \n    def forward(self, x):  \n        x = self.relu(self.linear1(x))  \n        x = self.relu(self.linear2(x))  \n        x = self.linear3(x)  \n        return x  \n  \n  \nmodel = RegressionModel()  \n  \n# 3. 损失函数与优化器（调小一点学习率，配合标准化数据）  \ncriterion = torch.nn.MSELoss(reduction='mean')  \noptimizer = torch.optim.Adam(model.parameters(), lr=0.01)  \n  \n# 4. 训练  \nfor epoch in range(100):  \n    y_pred = model(x_data)  \n    loss = criterion(y_pred, y_data)  \n  \n    if epoch % 10 == 0:  \n        print(f\"Epoch: {epoch}, Loss: {loss.item():.4f}\")  \n  \n    optimizer.zero_grad()  \n    loss.backward()  \n    optimizer.step()  \n  \n# 5. 测试：如何把预测出来的“小数字”变回“真实的疾病指数”？  \nprint(\"\\n--- 训练结束验证 ---\")  \nmodel.eval()  # 切换到评估模式  \nwith torch.no_grad():  \n    # 拿第一个样本做预测  \n    test_pred_scaled = model(x_data[0:1])  \n    # 使用 inverse_transform 把结果反标准化  \n    test_pred_real = scaler_y.inverse_transform(test_pred_scaled.numpy())  \n  \n    print(f\"真实目标值: {y_numpy[0][0]}\")  \n    print(f\"模型预测值: {test_pred_real[0][0]:.2f}\")\n```","x":-2720,"y":925,"width":768,"height":1370}
	],
