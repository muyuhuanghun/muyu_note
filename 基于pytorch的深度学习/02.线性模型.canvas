		{"id":"c3dbba7587f51512","type":"text","text":"Linear Model","x":-80,"y":420,"width":250,"height":60},
		{"id":"47d39561be136dbb","type":"text","text":"$$\n\\hat{y} = x * \\omega +b\n$$","x":270,"y":420,"width":250,"height":60},
		{"id":"3be9dd5346d2cf3a","type":"text","text":"the machine starts with a random guess,omega = random value","x":599,"y":400,"width":250,"height":101},
		{"id":"b3aae7ef2dc2444a","type":"text","text":"training loss (损失)","x":599,"y":600,"width":250,"height":60},
		{"id":"5b4fcbaa2817c150","type":"text","text":"$$\nloss = (\\hat {y} - y)^2 = (x * \\omega -y)^2\n$$","x":940,"y":600,"width":250,"height":60},
		{"id":"7a0865be7458fb4c","type":"text","text":"mean square error (mse)","x":599,"y":740,"width":250,"height":60},
		{"id":"672c9ad305c4f969","type":"text","text":"$$\ncost = 1/N \\sum_{n=1}^{N} (\\hat{y_n} - y_n)^2\n$$","x":940,"y":740,"width":250,"height":60},
