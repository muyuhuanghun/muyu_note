		{"id":"d6ad258e8ece2456","type":"file","file":"基于pytorch的深度学习/pythorch photos/numlayers.png","x":1100,"y":-331,"width":731,"height":346},
		{"id":"de3ac0b3023e7ed6","type":"text","text":"simple model","x":1341,"y":120,"width":250,"height":60},
		{"id":"1d262cf0fe4821a7","type":"file","file":"基于pytorch的深度学习/pythorch photos/simple model.png","x":1100,"y":240,"width":731,"height":393},
		{"id":"5f5aa38f5f022cca","type":"text","text":"x","x":1940,"y":-218,"width":250,"height":60},
		{"id":"7faeb27ac41ee2f7","type":"text","text":"embedding layer","x":2280,"y":-218,"width":250,"height":60},
		{"id":"9af18b6b1e5a90f1","type":"text","text":"GRU Layer","x":2620,"y":-218,"width":250,"height":60},
		{"id":"f86086ca1ac77e18","type":"text","text":"$$\nh_0\n$$","x":2620,"y":-331,"width":250,"height":60},
		{"id":"f6a7b8aa613dba03","type":"text","text":"$$\nh_N\n$$","x":2960,"y":-218,"width":250,"height":60},
		{"id":"8366322cf0a37af2","type":"text","text":"Linear Layer","x":3300,"y":-218,"width":250,"height":60},
		{"id":"601cbc9f8f81799f","type":"text","text":"main cycle","x":2120,"y":-45,"width":250,"height":60},
		{"id":"f907745b0651c7bb","type":"text","text":"```\nif__name__=='__main__':\n\tclassifier = RNNClassifier(N_CHARS,HIDDEN_SIZE,N_COUNTRY,N_LAYER)\n\tif USE_GPU:\n\t\tdevice = torch.device('cude:0')\n\t\tclassifier.to(device)\n\t\t\n\tcriterion = torch.nn.CrossEntropyLoss()\n\toptimizer = torch.optim.Adam(classifier.parameters(),lr=0.001)\n\t\n\tstart = time.time()\n\tprint(\"Training for %d epochs..\"% N_EPOCHS)\n\tacc_list = []\n\tfor epoch in range(1,N_EPOCHS+1)\n\t\ttrainModel()\n\t\tacc = testModel()\n\t\tacc_list.append(acc)\n```","x":2472,"y":-45,"width":828,"height":428},
		{"id":"cd58658ee14a7ac2","type":"text","text":"our model","x":2120,"y":-331,"width":250,"height":60},
		{"id":"a6492c0544332d7e","type":"text","text":"preparing data","x":-100,"y":760,"width":250,"height":60},
		{"id":"65101fe1e17a837b","type":"file","file":"基于pytorch的深度学习/pythorch photos/country2name.png","x":260,"y":642,"width":689,"height":296},
		{"id":"2fa28738cfdac244","type":"text","text":"实则为128维向量","x":680,"y":540,"width":250,"height":60},
		{"id":"4dd93aeed5a56930","type":"text","text":"长度不一致，需要padding填充","x":1020,"y":760,"width":250,"height":60},
		{"id":"bcc2d2010ce12394","type":"text","text":"将国家作为索引","x":1020,"y":878,"width":250,"height":60},
		{"id":"0f811612271c1f4e","type":"text","text":"```\nclass NameDataset(Dataset)\n\tdef__init__(self,is_train_set=Ture)\n\t\tfilename = 'data/names_train.csv.gz' if is_train_set else 'data/names_test.csv.gz'\n\t\twith gzip.open(filename,'rt') as f:\n\t\t\treader = csv.reader(f)\n\t\t\trows = list(reader)\n\t\t\t\n\t\tself.names = [row[0] for row in rows]\n\t\tself.len = len(self.names)\n\t\tself.counrties = [row[1] for row in rows]\n\t\tself.country_list = list(sorted(set(self.countries)))\n\t\tself.country_dict = self.getCountryDict()\n\t\tself.country_num = len(self.coutry_list)\n\t\t\n\tdef__getitem__(self,index):\n\t\treturn self.names[index],self.country_dict[self.coutries[index]]\n\t\t\n\t\t\n\tdef__len__(self):\n\t\treturn self.len\n\t\t\n\tdef getCountryDict(self):\n\t\tcountry_dict = dict()\n\t\tfor idx,country_name in enumerate(self.country_list,0):\n\t\t\tcountry_dict[country_name]=idx\n\t\treturn country_dict\n\t\t\n\tdef idx2Country(self,index):\n\t\treturn self.country_list[index]\n\t\t\n\tdef getCountriesNum(self):\n\t\treturn self.country_num\n```","x":2472,"y":480,"width":828,"height":840},
		{"id":"15c076f48a972518","type":"text","text":"```\ntrainset = NameDataset(is_train_set = Ture)\ntrainloader = DataLoader(trainset,batch_size=BATCH_SIZE,shuffle = Ture)\ntestset = NameDataset(is_trian_set = False)\ntestloader = DataLoader(testset,batch_size=BATCH_SIZE,shuffle = False)\n\nN_COUTRY = trainset.getCounteiesNum()\n```","x":2472,"y":1400,"width":828,"height":200},
		{"id":"75892ae76c5015e9","type":"text","text":"```\nclass RNNClassifier(torch.nn.Module):\n\tdef __init__(self,input_size,hidden_szie,output_size,n_layers=1,bidirectional = Ture)\n\t\tsuper(RNNClassifier,self).__init__()\n\t\tself.hidden_size = hidden_size\n\t\tself.n_layers = n_layers\n\t\tself.n_directions = 2 if bidirecional else 1\n\t\t\n\t\tself.embedding = torch.nn.Embedding(input_size,hidden_size)\n\t\tself.gru = torch.nn.GRU(hidden_size,hidden_size,n_layers,\n\t\t\t\t\t\t\t\tbiderectional=biderectional)\n\t\t\t\t\t\t\t\t\n\t\tself.fc = torch.nn.Linear(hidden_size*self.n_directions,output_size)\n\t\t\n\tdef _init_hidden(self,batch_size):\n\t\thidden = torch.zeros(self.n_layers * self.n_directions,\n\t\t\t\t\t\t\tbatch_size,self.hidden_size)\n\t\treturn create_tensor(hidden)\n\t\t\n\tdef forward(self,input,seq_lenngths):\n\t\tinput = input.t()\n\t\tbatch_size = input.size(1)\n\t\t\n\t\thidden = self._init_hidden(batch_size)\n\t\tembedding = self.embedding(input)\n\t\t\n\t\tgru_input = pack_padded_sequence(embedding,seq_lengths)\n\t\t\n\t\toutput,hidden = self.gru(gru_input,hidden)\n\t\tif self.n_directions == 2:\n\t\t\thidden_cat = torch.cat([hidden[-1],hidden[-2]],dim=1)\n\t\telse:\n\t\t\thidden_cat = hidden[-1]\n\t\t\t\n\t\tfc_output = self.fc(hidden_cat)\n\t\treturn fc_output\n```","x":3460,"y":-45,"width":840,"height":805},
		{"id":"da1e9558b9851722","type":"text","text":"bidirection 双向循环神经网络","x":4480,"y":158,"width":250,"height":60},
		{"id":"08e5c3df1d13133a","type":"text","text":"convert name too tensor","x":-100,"y":1160,"width":250,"height":60},
		{"id":"c3e6896cb79cfbc9","type":"text","text":"```\ndef make_tensors(names,countries)\n\tsequences_and_lengths = [name2list(name) for name in names]\n\tname_sequences = [sl[0] for sl in sequences_and_lengths]\n\tseq_lengths = torch.LongTensor([sl[1] for sl in sequences_and_lengths])\n\tcountries = countries.long()\n\t\n\tseq_tensor = torch.zeros(len(name_sequences),seq_lengths.max()).long()\n\tfor idx , (seq,seq_len) in enumerate(zip(name_sequences,seq_lengths),0):\n\t\tseq_tensor[idx,:seq_len] = torch.LongTensor(seq)\n\t\t\n\tseq_lengths,perm_idx = seq_lengths.sort(dim=0,descending  = Tuere)\n\tseq_tensor = seq_tensor[perm_idx]\n\tcountries = countries[perm_idx]\n\t\n\treturn create_tensor(seq_tensor),\\\n\t\t   create_tensor(seq_lengths),\\\n\t\t   craete_tensor(countries)\n```","x":260,"y":957,"width":1010,"height":467},
		{"id":"958b3c44226c556f","type":"text","text":"```\ndef trainModel():\n\ttotal_loss=0\n\tfor i ,(names,countries) in enumerate(trainloader,1)\"\n\t\tinputs,seq_lengths,target = make_tensor(names,countries)\n\t\toutput = classifier(inputs,seq_lengths)\n\t\tloss = criterion(output,target)\n\t\toptimizer.zero_grad()\n\t\tloss.backward()\n\t\toptimizer.step()\n\t\t\n\t\ttotal_loss.+=loss.item()\n\t\tif i%10 ==0;\n\t\t\tprint(f'[{time_since(start)}] Epoch{epoch}',end='')\n\t\t\tprint(f'[{i * len(inputs)}/{len(trainset)}]',end='')\n\t\t\tprint(f'loss={total_loss/(i*len(inouts))}')\n\t\t\t\n\t\treturn total_loss\n\n```","x":260,"y":1560,"width":1010,"height":480},
		{"id":"99d1e244eef1b836","type":"text","text":"One Epoch Training","x":-100,"y":1770,"width":250,"height":60},
		{"id":"45b5f9328717af3d","type":"text","text":"Testing","x":-100,"y":2300,"width":250,"height":60},
		{"id":"8f1a3c975eb4d658","type":"text","text":"```\ndef testModel():\n\tcorrect = 0\n\ttotal = len(testset)\n\tprint(\"evaluating trained model ...\")\n\twith torch.no_grad():\n\t\tfor i,(names,countries) in enumerate(testloader,1):\n\t\t\tinputs,seq_lengths,target = make_tensors(names,countries)\n\t\t\toutput = classifier(inputs,seq_lengths)\n\t\t\tpred = output.max(dim=1,keepdim=Ture)[1]\n\t\t\tcorrect += pred.eq(target.view_as(pred)).sum().item()\n\t\t\t\n\t\tpercent = '%2.f'%(100*correct/total)\n\t\tprint(f'Test set: Accuracy {correct}/{total} {percent}%)\n\t\t\n\treturn correct/total\n```","x":260,"y":2140,"width":1010,"height":380},
