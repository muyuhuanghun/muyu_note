		{"id":"e1b2c3d4e5f60302","fromNode":"a1b2c3d4e5f60301","fromSide":"right","toNode":"a1b2c3d4e5f60302","toSide":"left"},
		{"id":"e1b2c3d4e5f60303","fromNode":"a1b2c3d4e5f60302","fromSide":"bottom","toNode":"a1b2c3d4e5f60303","toSide":"top"},
		{"id":"e1b2c3d4e5f60304","fromNode":"a1b2c3d4e5f60302","fromSide":"right","toNode":"a1b2c3d4e5f60304","toSide":"left","label":"多头=多个并行"},
		{"id":"e1b2c3d4e5f60305","fromNode":"a1b2c3d4e5f60203","fromSide":"bottom","toNode":"a1b2c3d4e5f60305","toSide":"top"},
		{"id":"e1b2c3d4e5f60306","fromNode":"a1b2c3d4e5f60305","fromSide":"bottom","toNode":"a1b2c3d4e5f60306","toSide":"top"},
		{"id":"e1b2c3d4e5f60307","fromNode":"a1b2c3d4e5f60306","fromSide":"right","toNode":"a1b2c3d4e5f60307","toSide":"left","label":"替代方案"},
		{"id":"e1b2c3d4e5f60401","fromNode":"a1b2c3d4e5f60103","fromSide":"bottom","toNode":"a1b2c3d4e5f60204","toSide":"top"},
		{"id":"e1b2c3d4e5f60402","fromNode":"a1b2c3d4e5f60204","fromSide":"right","toNode":"a1b2c3d4e5f60205","toSide":"left"},
		{"id":"e1b2c3d4e5f60403","fromNode":"a1b2c3d4e5f60204","fromSide":"bottom","toNode":"a1b2c3d4e5f60401","toSide":"top"},
		{"id":"e1b2c3d4e5f60404","fromNode":"a1b2c3d4e5f60401","fromSide":"right","toNode":"a1b2c3d4e5f60402","toSide":"left"},
		{"id":"e1b2c3d4e5f60405","fromNode":"a1b2c3d4e5f60402","fromSide":"right","toNode":"a1b2c3d4e5f60403","toSide":"left"},
		{"id":"e1b2c3d4e5f60501","fromNode":"a1b2c3d4e5f60205","fromSide":"bottom","toNode":"a1b2c3d4e5f60500","toSide":"top"},
		{"id":"e1b2c3d4e5f60502","fromNode":"a1b2c3d4e5f60501","fromSide":"right","toNode":"a1b2c3d4e5f60502","toSide":"left","label":"×N堆叠"},
		{"id":"e1b2c3d4e5f60503","fromNode":"a1b2c3d4e5f60502","fromSide":"right","toNode":"a1b2c3d4e5f60503","toSide":"left","label":"K,V传Decoder"},
		{"id":"e1b2c3d4e5f60504","fromNode":"a1b2c3d4e5f60503","fromSide":"bottom","toNode":"a1b2c3d4e5f60504","toSide":"left","label":"Masked"},
		{"id":"e1b2c3d4e5f60505","fromNode":"a1b2c3d4e5f60503","fromSide":"right","toNode":"a1b2c3d4e5f60505","toSide":"left","label":"Cross-Attn"},
		{"id":"e1b2c3d4e5f60506","fromNode":"a1b2c3d4e5f60505","fromSide":"right","toNode":"a1b2c3d4e5f60506","toSide":"left","label":"Decoder堆叠"},
		{"id":"e1b2c3d4e5f60601","fromNode":"a1b2c3d4e5f60502","fromSide":"bottom","toNode":"a1b2c3d4e5f60601","toSide":"top","label":"完整流程"},
		{"id":"e1b2c3d4e5f60602","fromNode":"a1b2c3d4e5f60506","fromSide":"bottom","toNode":"a1b2c3d4e5f60602","toSide":"top"},
